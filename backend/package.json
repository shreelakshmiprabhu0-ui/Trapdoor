{
  "name": "trapdoor-backend",
  "version": "1.0.0",
  "description": "TRAPDOOR backend — Express gateway with trap routes and event logging",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:integration": "cross-env RUN_INTEGRATION=true jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "mysql2": "^3.9.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/../tests"
    ],
    "testMatch": [
      "<rootDir>/../tests/**/*.test.js"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  },
  "overrides": {}
}
