# Copy to .env and change every value. Never commit .env.
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Set to true when served over HTTPS
COOKIE_SECURE=false

DB_NAME=trapdoor
DB_USER=trapdoor_app
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
